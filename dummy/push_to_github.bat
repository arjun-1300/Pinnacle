@echo off
REM ============================================================
REM  push_to_github.bat
REM  Pinnacle ? Multi-Agent Healthcare Monitoring System
REM  Stages all project files, commits, and pushes to GitHub.
REM
REM  USAGE:
REM    1. Set GITHUB_REPO_URL below to your repository remote.
REM    2. Double-click this file or run from Command Prompt.
REM
REM  Requirements:
REM    - Git installed and on PATH
REM    - GitHub credentials configured (SSH key or credential manager)
REM ============================================================

setlocal enabledelayedexpansion

REM ?? CONFIGURATION ?????????????????????????????????????????????????????????
set "REPO_ROOT=%~dp0"
REM Replace the URL below with your actual GitHub repository remote:
set "GITHUB_REPO_URL=https://github.com/YOUR_USERNAME/pinnacle-healthcare.git"
set "BRANCH=main"
set "COMMIT_MSG=Phase 5: Demo verification, guides, presentation outline, and GitHub push script"

REM ?? BANNER ????????????????????????????????????????????????????????????????
echo.
echo ============================================================
echo   Pinnacle ^| GitHub Push Script
echo ============================================================
echo.

REM ?? CHECK GIT INSTALLATION ????????????????????????????????????????????????
where git >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Git is not installed or not on PATH.
    echo         Download from https://git-scm.com/download/win
    pause
    exit /b 1
)
echo [OK] Git found: 
git --version

REM ?? NAVIGATE TO REPO ROOT ?????????????????????????????????????????????????
cd /d "%REPO_ROOT%"
echo [OK] Working directory: %CD%

REM ?? INITIALISE GIT REPO IF NEEDED ?????????????????????????????????????????
if not exist ".git" (
    echo [INIT] No .git directory found. Initialising new repository...
    git init -b %BRANCH%
    if errorlevel 1 ( echo [ERROR] git init failed. & pause & exit /b 1 )
    echo [OK] Repository initialised on branch '%BRANCH%'.
) else (
    echo [OK] Existing .git repository detected.
)

REM ?? CONFIGURE REMOTE ??????????????????????????????????????????????????????
git remote get-url origin >nul 2>&1
if errorlevel 1 (
    echo [REMOTE] Adding remote origin: %GITHUB_REPO_URL%
    git remote add origin %GITHUB_REPO_URL%
    if errorlevel 1 ( echo [ERROR] Failed to add remote. & pause & exit /b 1 )
) else (
    echo [REMOTE] Updating remote origin to: %GITHUB_REPO_URL%
    git remote set-url origin %GITHUB_REPO_URL%
)

REM ?? STAGE ALL FILES ???????????????????????????????????????????????????????
echo.
echo [STAGE] Staging all tracked and untracked files...
git add -A
if errorlevel 1 ( echo [ERROR] git add failed. & pause & exit /b 1 )

REM Show what will be committed
echo.
echo [STATUS] Files staged for commit:
git status --short

REM ?? COMMIT ????????????????????????????????????????????????????????????????
echo.
echo [COMMIT] Committing with message:
echo          "%COMMIT_MSG%"
git diff --cached --quiet
if not errorlevel 1 (
    echo [SKIP] Nothing new to commit. Working tree is clean.
    goto :push
)
git commit -m "%COMMIT_MSG%"
if errorlevel 1 (
    echo [ERROR] git commit failed. Check git config user.name and user.email.
    echo         Run: git config --global user.name "Your Name"
    echo              git config --global user.email "you@example.com"
    pause
    exit /b 1
)
echo [OK] Commit successful.

:push
REM ?? PUSH TO GITHUB ????????????????????????????????????????????????????????
echo.
echo [PUSH] Pushing to %GITHUB_REPO_URL% on branch '%BRANCH%'...
git push -u origin %BRANCH%
if errorlevel 1 (
    echo.
    echo [WARN] Push failed. Common causes:
    echo   1. GITHUB_REPO_URL is still the placeholder value above.
    echo      Edit this .bat file and set the correct URL.
    echo   2. Authentication not configured.
    echo      Use SSH key or run: git credential-manager configure
    echo   3. Remote branch does not exist yet.
    echo      Try: git push --set-upstream origin %BRANCH%
    pause
    exit /b 1
)

echo.
echo ============================================================
echo   [SUCCESS] All files pushed to GitHub successfully!
echo   Repository: %GITHUB_REPO_URL%
echo   Branch    : %BRANCH%
echo ============================================================
echo.
pause
